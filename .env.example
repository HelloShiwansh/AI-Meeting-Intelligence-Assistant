# Choose: mistral, gemini, groq, openai, anthropic, openai_compatible
LLM_PROVIDER=mistral
# Set a model supported by the selected provider and your account.
LLM_MODEL=mistral-small-latest

# Only the selected provider's key is required.
MISTRAL_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# For openai_compatible only: endpoint including /v1, and its API key.
LLM_BASE_URL=
LLM_API_KEY=
SARVAM_API_KEY=your_sarvam_api_key
WHISPER_MODEL=small

# Shared chunk analysis: reduce concurrency to 1 for restrictive free tiers.
ANALYSIS_MAX_CONCURRENCY=3
# Conservative input budgets: one unit per UTF-8 byte, including non-English text.
ANALYSIS_CHUNK_BUDGET=6000
ANALYSIS_OVERLAP_BUDGET=300
ANALYSIS_INPUT_BUDGET=16000
